        "# hvdc-graded-dielectric-sim-poc — Stage 2 & Stage 4 Colab Notebook\n",
        "\n",
        "**Status:** Simulated POC (In Silico) — Underlying Mode B Material To Be Developed / Not Yet POC'd  \n",
        "**Primary Author:** Abhishek Singh (ORCID: https://orcid.org/0009-0004-6913-096X | GitHub: https://github.com/Abhishek1033ubuntu)  \n",
        "**Co-Author / AI Research Collaborator:** Google Gemini  \n",
        "\n",
        "This notebook runs the calibrated 1D cylindrical radial heat-conduction, Poisson, and CFL-stabilized bipolar charge-transport solver comparing standard XLPE against the radially graded **Mode B** dielectric (PFCB / Oligosiloxane / 6FDA-TFMB block terpolymer with 1.2 vol% surface-silanized `11B15N` nanosheets) on a 525 kV HVDC cable under `W_c = 120 W/m` overload and a `+525 kV` to `-525 kV` Voltage Polarity Reversal (VPR)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "from scipy.linalg import solve_banded\n",
        "\n",
        "# ==============================================================================\n",
        "# Calibrated 1D Cylindrical Electro-Thermal & Bipolar Charge Solver\n",
        "# Comparing Standard XLPE vs. Mode B (Field-Graded PFCB-Siloxane-Imide / 11B15N)\n",
        "# Status: Simulated POC; Mode B Material To Be Developed / Not Yet POC'd\n",
        "# Author: Abhishek Singh | ORCID: 0009-0004-6913-096X | Co-Author: Google Gemini\n",
        "# ==============================================================================\n",
        "\n",
        "e_charge = 1.602176634e-19   # Elementary charge [C]\n",
        "k_B_eV = 8.617333262e-5      # Boltzmann constant [eV/K]\n",
        "eps_0 = 8.854187817e-12      # Vacuum permittivity [F/m]\n",
        "\n",
        "# 525 kV HVDC Cable Geometry & Extreme Overload Case (Wc = 120 W/m, To = 45 C)\n",
        "r_i = 0.025                  # Inner semicon screen radius [m]\n",
        "r_o = 0.052                  # Outer insulation screen radius [m]\n",
        "V_dc = 525.0e3               # Nominal DC voltage [V]\n",
        "W_c = 120.0                  # Conductor Joule loss [W/m]\n",
        "T_o = 318.15                 # Outer sheath temperature [K] (45.0 C)\n",
        "\n",
        "Nr = 160                     # Radial grid nodes\n",
        "r = np.linspace(r_i, r_o, Nr)\n",
        "dr = r[1] - r[0]\n",
        "\n",
        "\n",
        "def solve_cylindrical_poisson(r_grid, rho, eps_r, V_inner, V_outer=0.0):\n",
        "    \"\"\"Solves (1/r) d/dr (r eps_0 eps_r dV/dr) = -rho with Dirichlet BCs.\"\"\"\n",
        "    N = len(r_grid)\n",
        "    dr_loc = r_grid[1] - r_grid[0]\n",
        "    eps = eps_0 * eps_r\n",
        "    ab = np.zeros((3, N))\n",
        "    rhs = np.zeros(N)\n",
        "\n",
        "    ab[1, 0] = 1.0\n",
        "    rhs[0] = V_inner\n",
        "    ab[1, -1] = 1.0\n",
        "    rhs[-1] = V_outer\n",
        "\n",
        "    r_mid_plus = 0.5 * (r_grid[1:-1] + r_grid[2:])\n",
        "    r_mid_minus = 0.5 * (r_grid[1:-1] + r_grid[:-2])\n",
        "    c_plus = r_mid_plus / (r_grid[1:-1] * dr_loc**2)\n",
        "    c_minus = r_mid_minus / (r_grid[1:-1] * dr_loc**2)\n",
        "\n",
        "    ab[0, 2:] = c_plus\n",
        "    ab[1, 1:-1] = -(c_plus + c_minus)\n",
        "    ab[2, :-2] = c_minus\n",
        "    rhs[1:-1] = -rho[1:-1] / eps\n",
        "\n",
        "    V = solve_banded((1, 1), ab, rhs)\n",
        "    E = -np.gradient(V, dr_loc)\n",
        "    return V, E\n",
        "\n",
        "\n",
        "def run_calibrated_hvdc(material=\"XLPE\"):\n",
        "    if material == \"XLPE\":\n",
        "        eps_r = 2.30\n",
        "        kappa = 0.28                     # W/(m.K)\n",
        "        T = T_o + (W_c / (2.0 * np.pi * kappa)) * np.log(r_o / r)\n",
        "        Ea = np.full_like(r, 0.90)       # Uniform activation energy [eV]\n",
        "        mu0 = 1.2e-4                     # Base mobility prefactor [m^2/(V.s)]\n",
        "        Et_e, Et_h = 0.72, 0.70          # Shallow/medium trap depths [eV]\n",
        "        Nt_e = np.full_like(r, 8.0e19)   # Calibrated PEA net trap density [m^-3]\n",
        "        Nt_h = np.full_like(r, 8.0e19)\n",
        "        phi_inj = 1.30                   # Effective Schottky injection barrier [eV]\n",
        "        Cn, Cp = 3.5e-18, 3.5e-18        # Capture coefficients [m^3/s]\n",
        "        beta_pf = np.sqrt(e_charge / (np.pi * eps_0 * eps_r))\n",
        "    else:\n",
        "        # Mode B: Field-Graded PFCB-Siloxane-Imide + 1.2 vol% 11B15N (To Be Developed)\n",
        "        eps_r = 2.65\n",
        "        kappa = 1.15                     # W/(m.K) via isotopic 11B15N phonon channels\n",
        "        T = T_o + (W_c / (2.0 * np.pi * kappa)) * np.log(r_o / r)\n",
        "        Ea_o = 1.150                     # Baseline activation energy at outer screen [eV]\n",
        "        Ea = Ea_o * (T / T_o)            # Radial law: Ea(r)/T(r) = const\n",
        "        mu0 = 4.2e-5\n",
        "        Et_e, Et_h = 1.95, 1.80          # Deep fluorinated & 11B15N edge traps [eV]\n",
        "        Nt_e = 2.8e23 * (Ea / Ea_o)**16.0\n",
        "        Nt_h = 1.9e23 * (Ea / Ea_o)**16.0\n",
        "        phi_inj = 1.65                   # Homocharge-pinned injection barrier [eV]\n",
        "        Cn, Cp = 1.8e-16, 1.8e-16\n",
        "        beta_pf = 0.25 * np.sqrt(e_charge / (np.pi * eps_0 * eps_r))\n",
        "\n",
        "    nu0 = 6.0e12                         # Attempt-to-escape frequency [s^-1]\n",
        "    detrap_e = nu0 * np.exp(-Et_e / (k_B_eV * T))\n",
        "    detrap_h = nu0 * np.exp(-Et_h / (k_B_eV * T))\n",
        "\n",
        "    n_free = np.full_like(r, 5.0e12)\n",
        "    p_free = np.full_like(r, 5.0e12)\n",
        "    n_trap = np.zeros_like(r)\n",
        "    p_trap = np.zeros_like(r)\n",
        "\n",
        "    A_rich = 1.2017e6                    # Richardson constant [A/(m^2 K^2)]\n",
        "    beta_sch = np.sqrt(e_charge**3 / (4.0 * np.pi * eps_0 * eps_r))\n",
        "    R_rec = 2.5e-18                      # Recombination coefficient [m^3/s]\n",
        "\n",
        "    dt_macro = 2.0\n",
        "    t_steady = 18000.0\n",
        "    t_vpr = 120.0\n",
        "    steps_steady = int(t_steady / dt_macro)\n",
        "    steps_vpr = int(t_vpr / dt_macro)\n",
        "\n",
        "    E_pre_vpr = None\n",
        "    rho_pre_vpr = None\n",
        "    E_post_envelope = np.zeros_like(r)\n",
        "    r_faces = np.concatenate(([r_i], 0.5 * (r[:-1] + r[1:]), [r_o]))\n",
        "\n",
        "    for step in range(steps_steady + steps_vpr):\n",
        "        if step < steps_steady:\n",
        "            V_app = V_dc\n",
        "        else:\n",
        "            frac = (step - steps_steady + 1) / steps_vpr\n",
        "            V_app = V_dc * (1.0 - 2.0 * frac)  # Ramp +525 kV -> -525 kV\n",
        "\n",
        "        rho = e_charge * (p_free + p_trap - n_free - n_trap)\n",
        "        _, E = solve_cylindrical_poisson(r, rho, eps_r, V_app, 0.0)\n",
        "\n",
        "        pf_arg = np.clip(beta_pf * np.sqrt(np.abs(E)) / (k_B_eV * T), 0.0, 12.0)\n",
        "        mu_e = mu0 * np.exp(-Ea / (k_B_eV * T) + pf_arg)\n",
        "        mu_h = 0.65 * mu_e\n",
        "\n",
        "        v_max = max(np.max(mu_e * np.abs(E)), 1e-12)\n",
        "        dt_cfl = 0.4 * dr / v_max\n",
        "        n_sub = int(np.clip(np.ceil(dt_macro / dt_cfl), 1, 50))\n",
        "        dt = dt_macro / n_sub\n",
        "\n",
        "        for _ in range(n_sub):\n",
        "            rho = e_charge * (p_free + p_trap - n_free - n_trap)\n",
        "            _, E = solve_cylindrical_poisson(r, rho, eps_r, V_app, 0.0)\n",
        "            if step >= steps_steady:\n",
        "                E_post_envelope = np.maximum(E_post_envelope, np.abs(E))\n",
        "\n",
        "            pf_arg = np.clip(beta_pf * np.sqrt(np.abs(E)) / (k_B_eV * T), 0.0, 12.0)\n",
        "            mu_e = mu0 * np.exp(-Ea / (k_B_eV * T) + pf_arg)\n",
        "            mu_h = 0.65 * mu_e\n",
        "\n",
        "            E_in, E_out = E[0], E[-1]\n",
        "            barr_in = max(0.55, phi_inj - beta_sch * np.sqrt(abs(E_in)) / e_charge)\n",
        "            barr_out = max(0.55, phi_inj - beta_sch * np.sqrt(abs(E_out)) / e_charge)\n",
        "\n",
        "            J_p_in = (A_rich * T[0]**2 / e_charge) * np.exp(-barr_in / (k_B_eV * T[0])) if E_in >= 0 else 0.0\n",
        "            J_n_in = (A_rich * T[0]**2 / e_charge) * np.exp(-barr_in / (k_B_eV * T[0])) if E_in < 0 else 0.0\n",
        "            J_n_out = (A_rich * T[-1]**2 / e_charge) * np.exp(-barr_out / (k_B_eV * T[-1])) if E_out >= 0 else 0.0\n",
        "            J_p_out = (A_rich * T[-1]**2 / e_charge) * np.exp(-barr_out / (k_B_eV * T[-1])) if E_out < 0 else 0.0\n",
        "\n",
        "            F_p = np.zeros(Nr + 1)\n",
        "            F_n = np.zeros(Nr + 1)\n",
        "            F_p[0], F_p[-1] = J_p_in, -J_p_out\n",
        "            F_n[0], F_n[-1] = -J_n_in, J_n_out\n",
        "\n",
        "            E_face = 0.5 * (E[:-1] + E[1:])\n",
        "            mu_p_face = 0.5 * (mu_h[:-1] + mu_h[1:])\n",
        "            mu_n_face = 0.5 * (mu_e[:-1] + mu_e[1:])\n",
        "\n",
        "            p_up = np.where(E_face >= 0, p_free[:-1], p_free[1:])\n",
        "            n_up = np.where(E_face >= 0, n_free[1:], n_free[:-1])\n",
        "            F_p[1:-1] = mu_p_face * E_face * p_up\n",
        "            F_n[1:-1] = -mu_n_face * E_face * n_up\n",
        "\n",
        "            div_Fp = (r_faces[1:] * F_p[1:] - r_faces[:-1] * F_p[:-1]) / (r * dr)\n",
        "            div_Fn = (r_faces[1:] * F_n[1:] - r_faces[:-1] * F_n[:-1]) / (r * dr)\n",
        "\n",
        "            trap_rate_e = Cn * n_free * np.maximum(0.0, 1.0 - n_trap / Nt_e) - detrap_e * n_trap\n",
        "            trap_rate_h = Cp * p_free * np.maximum(0.0, 1.0 - p_trap / Nt_h) - detrap_h * p_trap\n",
        "            recomb = R_rec * (n_free * p_free + n_free * p_trap + p_free * n_trap)\n",
        "\n",
        "            n_free = np.clip(n_free + dt * (-div_Fn - trap_rate_e - recomb), 1.0e6, 1.0e21)\n",
        "            p_free = np.clip(p_free + dt * (-div_Fp - trap_rate_h - recomb), 1.0e6, 1.0e21)\n",
        "            n_trap = np.clip(n_trap + dt * (trap_rate_e - R_rec * p_free * n_trap), 0.0, Nt_e)\n",
        "            p_trap = np.clip(p_trap + dt * (trap_rate_h - R_rec * n_free * p_trap), 0.0, Nt_h)\n",
        "\n",
        "        if step == steps_steady - 1:\n",
        "            E_pre_vpr = E.copy()\n",
        "            rho_pre_vpr = rho.copy()\n",
        "\n",
        "    rho_post_vpr = e_charge * (p_free + p_trap - n_free - n_trap)\n",
        "    return {\n",
        "        \"r_mm\": r * 1e3,\n",
        "        \"T_C\": T - 273.15,\n",
        "        \"dT\": T[0] - T[-1],\n",
        "        \"rho_pre\": rho_pre_vpr,\n",
        "        \"E_pre_kvmm\": E_pre_vpr / 1e6,\n",
        "        \"E_post_env_kvmm\": E_post_envelope / 1e6,\n",
        "        \"E_pre_i\": E_pre_vpr[0] / 1e6,\n",
        "        \"E_pre_o\": E_pre_vpr[-1] / 1e6,\n",
        "        \"E_post_max\": np.max(E_post_envelope) / 1e6,\n",
        "        \"rho_max\": np.max(np.abs(rho_post_vpr)),\n",
        "    }\n",
        "\n",
        "\n",
        "def plot_radial_comparison(res_xlpe, res_modeb, r_grid_m, v_dc_val, r_in, r_out):\n",
        "    \"\"\"Generates a 2x2 radial profile figure comparing XLPE vs. Mode B.\"\"\"\n",
        "    E_lap_kvmm = (v_dc_val / (r_grid_m * np.log(r_out / r_in))) / 1e6\n",
        "    r_mm = res_xlpe[\"r_mm\"]\n",
        "\n",
        "    fig, axes = plt.subplots(2, 2, figsize=(12.5, 8.5), dpi=300)\n",
        "    fig.suptitle(\n",
        "        \"525 kV HVDC Radial Profiles: XLPE vs. Mode B (Simulated POC; Material To Be Developed)\",\n",
        "        fontsize=13,\n",
        "        fontweight=\"bold\",\n",
        "    )\n",
        "\n",
        "    ax = axes[0, 0]\n",
        "    ax.plot(r_mm, res_xlpe[\"T_C\"], color=\"#d95f02\", lw=2.2, label=\"XLPE (dT = 49.95 K)\")\n",
        "    ax.plot(r_mm, res_modeb[\"T_C\"], color=\"#1b9e77\", lw=2.2, label=\"Mode B (dT = 12.16 K)\")\n",
        "    ax.set_title(\"Radial Temperature Profile\")\n",
        "    ax.set_xlabel(\"Radial Position r [mm]\")\n",
        "    ax.set_ylabel(\"Temperature T(r) [deg C]\")\n",
        "    ax.grid(True, linestyle=\"--\", alpha=0.4)\n",
        "    ax.legend()\n",
        "\n",
        "    ax = axes[0, 1]\n",
        "    ax.plot(r_mm, res_xlpe[\"rho_pre\"], color=\"#d95f02\", lw=2.2, label=\"XLPE rho [C/m^3]\")\n",
        "    ax.axhline(0.0, color=\"#666666\", lw=0.8, ls=\":\")\n",
        "    ax.set_title(\"Pre-VPR Net Space Charge\")\n",
        "    ax.set_xlabel(\"Radial Position r [mm]\")\n",
        "    ax.set_ylabel(\"XLPE Net Charge rho [C/m^3]\", color=\"#d95f02\")\n",
        "    ax.tick_params(axis=\"y\", labelcolor=\"#d95f02\")\n",
        "    ax.grid(True, linestyle=\"--\", alpha=0.4)\n",
        "\n",
        "    ax_r = ax.twinx()\n",
        "    ax_r.plot(\n",
        "        r_mm,\n",
        "        res_modeb[\"rho_pre\"] * 1e6,\n",
        "        color=\"#1b9e77\",\n",
        "        lw=2.0,\n",
        "        ls=\"--\",\n",
        "        label=\"Mode B rho [uC/m^3]\",\n",
        "    )\n",
        "    ax_r.set_ylabel(\"Mode B Net Charge rho [uC/m^3]\", color=\"#1b9e77\")\n",
        "    ax_r.tick_params(axis=\"y\", labelcolor=\"#1b9e77\")\n",
        "\n",
        "    ax = axes[1, 0]\n",
        "    ax.plot(r_mm, E_lap_kvmm, color=\"#2b5c8f\", lw=1.8, ls=\"-.\", label=\"Laplacian Reference\")\n",
        "    ax.plot(r_mm, res_xlpe[\"E_pre_kvmm\"], color=\"#d95f02\", lw=2.2, label=\"XLPE Pre-VPR E(r)\")\n",
        "    ax.plot(r_mm, res_modeb[\"E_pre_kvmm\"], color=\"#1b9e77\", lw=2.2, label=\"Mode B Pre-VPR E(r)\")\n",
        "    ax.axhline(0.0, color=\"#666666\", lw=0.8, ls=\":\")\n",
        "    ax.set_title(\"Pre-VPR Electric Field Profile\")\n",
        "    ax.set_xlabel(\"Radial Position r [mm]\")\n",
        "    ax.set_ylabel(\"Electric Field E(r) [kV/mm]\")\n",
        "    ax.grid(True, linestyle=\"--\", alpha=0.4)\n",
        "    ax.legend(loc=\"best\")\n",
        "\n",
        "    ax = axes[1, 1]\n",
        "    ax.plot(r_mm, E_lap_kvmm, color=\"#2b5c8f\", lw=1.8, ls=\"-.\", label=\"Laplacian Peak Ref\")\n",
        "    ax.plot(\n",
        "        r_mm,\n",
        "        res_xlpe[\"E_post_env_kvmm\"],\n",
        "        color=\"#d95f02\",\n",
        "        lw=2.2,\n",
        "        label=f\"XLPE Peak |E| ({res_xlpe['E_post_max']:.2f} kV/mm)\",\n",
        "    )\n",
        "    ax.plot(\n",
        "        r_mm,\n",
        "        res_modeb[\"E_post_env_kvmm\"],\n",
        "        color=\"#1b9e77\",\n",
        "        lw=2.2,\n",
        "        label=f\"Mode B Peak |E| ({res_modeb['E_post_max']:.2f} kV/mm)\",\n",
        "    )\n",
        "    ax.set_title(\"Post-VPR Peak Electric Field Envelope\")\n",
        "    ax.set_xlabel(\"Radial Position r [mm]\")\n",
        "    ax.set_ylabel(\"Peak |E(r)| During VPR [kV/mm]\")\n",
        "    ax.grid(True, linestyle=\"--\", alpha=0.4)\n",
        "    ax.legend(loc=\"best\")\n",
        "\n",
        "    plt.tight_layout(rect=[0, 0.02, 1, 0.95])\n",
        "    out_path = \"hvdc_modeb_radial_profiles.png\"\n",
        "    plt.savefig(out_path, dpi=300)\n",
        "    plt.show()\n",
        "    print(f\"Saved radial profile figure to: {out_path}\")\n",
        "\n",
        "\n",
        "res_xlpe = run_calibrated_hvdc(\"XLPE\")\n",
        "res_modeb = run_calibrated_hvdc(\"MODE_B\")\n",
        "\n",
        "E_lap_i = (V_dc / (r_i * np.log(r_o / r_i))) / 1e6\n",
        "E_lap_o = (V_dc / (r_o * np.log(r_o / r_i))) / 1e6\n",
        "\n",
        "print(f\"Geometric Laplacian Field: E(r_i) = {E_lap_i:.2f} kV/mm, E(r_o) = {E_lap_o:.2f} kV/mm\")\n",
        "print(\n",
        "    f\"XLPE   | dT = {res_xlpe['dT']:.2f} K | \"\n",
        "    f\"Pre-VPR E(r_i)/E(r_o) = {res_xlpe['E_pre_i']:.2f} / {res_xlpe['E_pre_o']:.2f} kV/mm | \"\n",
        "    f\"Post-VPR Peak |E| = {res_xlpe['E_post_max']:.2f} kV/mm | \"\n",
        "    f\"rho_max = {res_xlpe['rho_max']:.2e} C/m^3\"\n",
        ")\n",
        "print(\n",
        "    f\"Mode B | dT = {res_modeb['dT']:.2
